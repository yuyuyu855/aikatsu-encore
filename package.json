{
  "name": "aikatsu-encore",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "engines": { "node": ">=22.13.0" },
  "scripts": {
    "dev": "pnpm --filter @aikatsu/web dev",
    "build": "pnpm typecheck && pnpm --filter @aikatsu/web build",
    "build:pages": "pnpm typecheck && pnpm --filter @aikatsu/web build:pages && node scripts/publish/verify-pages.mjs",
    "preview:pages": "pnpm --filter @aikatsu/web preview:pages",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test && node --test scripts/catalog/test/official.test.mjs",
    "test:e2e": "playwright test",
    "test:e2e:pages": "pnpm build:pages && playwright test --config apps/web/e2e/pages/playwright.config.ts",
    "catalog:fetch": "node scripts/catalog/fetch-images.mjs",
    "catalog:validate": "node scripts/catalog/validate.mjs",
    "catalog:stage": "node scripts/catalog/stage.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "typescript": "5.9.3",
    "cheerio": "1.2.0",
    "image-size": "2.0.4",
    "undici": "7.30.0"
  }
}
