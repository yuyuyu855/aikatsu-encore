{
  "name": "aikatsu-encore",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "engines": { "node": ">=22.13.0" },
  "scripts": {
    "dev": "pnpm --filter @aikatsu/web dev",
    "build": "pnpm typecheck && pnpm --filter @aikatsu/web build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test && node --test scripts/catalog/test/official.test.mjs",
    "test:e2e": "playwright test",
    "catalog:fetch": "node scripts/catalog/fetch-images.mjs",
    "catalog:validate": "node scripts/catalog/validate.mjs",
    "catalog:stage": "node scripts/catalog/stage.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "typescript": "5.9.3",
    "cheerio": "1.2.0",
    "image-size": "2.0.4",
    "undici": "7.30.0"
  }
}
